{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animalguard:contract:detection-event:v1",
  "title": "AnimalGuard Detection Event v1",
  "description": "An image-level animal detection event sent from AI Server to Backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "cameraId",
    "capturedAt",
    "image",
    "model",
    "detections"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "UUID and duplicate-reception/idempotency key."
    },
    "cameraId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "ISO 8601 / RFC 3339 date-time with timezone."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detectorVersion",
        "classifierVersion"
      ],
      "properties": {
        "detectorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classifierVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "detections": {
      "type": "array",
      "maxItems": 100,
      "description": "At most 100 detections. Each detectionId must be unique within the event.",
      "items": {
        "$ref": "#/$defs/animalDetection"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "required": [
              "classifierVersion"
            ],
            "properties": {
              "classifierVersion": {
                "type": "null"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "detections": {
            "items": {
              "properties": {
                "classificationConfidence": {
                  "type": "null"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "detections": {
            "items": {
              "properties": {
                "classificationConfidence": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "animalDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detectionId",
        "trackId",
        "classCode",
        "detectionConfidence",
        "classificationConfidence",
        "bbox"
      ],
      "properties": {
        "detectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "trackId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "classCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Use UNKNOWN when the class is not known."
        },
        "detectionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classificationConfidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
