POSTGRES_DB=<set-locally>
POSTGRES_USER=<set-locally>
POSTGRES_PASSWORD=<set-locally>

# Backend MQTT transport. Keep disabled until the host and credentials below
# are replaced and the broker is reachable. Current clients use plain TCP.
MQTT_ENABLED=false
MQTT_HOST=<set-locally>
MQTT_PORT=1883
MQTT_CLIENT_ID=animalguard-backend
MQTT_USERNAME=<set-locally>
MQTT_PASSWORD=<set-locally>

BACKEND_BASE_URL=<set-locally>
AI_SERVER_BASE_URL=<set-locally>
DEVICE_COMMAND_TTL=10s

# Optional AI Server rolling frame evidence. Keep off unless an operator is
# actively reviewing recent analyzed frames on the server.
FRAME_EVIDENCE_MODE=off
FRAME_EVIDENCE_DIR=<set-locally>
FRAME_EVIDENCE_MAX_FILES_PER_CAMERA=60
FRAME_EVIDENCE_MIN_INTERVAL_SECONDS=1
FRAME_EVIDENCE_MAX_BYTES_PER_CAMERA=104857600

# Fail-closed deployment gates. Enable only in the documented readiness order.
ACTUATION_ENABLED=false
RISK_POLICY_CONFIRMED=false
RESPONSE_POLICY_ENABLED=false
OPERATOR_API_ENABLED=false
OPERATOR_API_TOKEN=<set-locally>
