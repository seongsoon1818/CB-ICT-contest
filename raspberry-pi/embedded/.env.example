# Required. The current controller supports plain MQTT TCP only; it does not
# call tls_set(). Use port 1883 unless TLS support is implemented first.
MQTT_HOST=
MQTT_PORT=1883

# Set both values for an authenticated broker. Leave both empty only when the
# broker explicitly permits anonymous access.
MQTT_USERNAME=
MQTT_PASSWORD=

# Must match the Backend camera-to-device mapping value.
MQTT_DEVICE_ID=pi-001
MQTT_KEEPALIVE_SECONDS=60

# The provided systemd unit creates and owns /var/lib/animalguard.
PROCESSED_COMMAND_DB=/var/lib/animalguard/processed_commands.db

# Required BCM pins. Confirm all five against the actual wiring; they must be
# unique. Do not copy guessed values into a real device.
MOTOR_IN1_PIN=
MOTOR_IN2_PIN=
MOTOR_SLEEP_PIN=
SERVO_PIN=
SPEAKER_PIN=

SERVO_STEP_DEGREES=5
SERVO_MIN_ANGLE=-60
SERVO_MAX_ANGLE=60

# Required. Set limits from each connected module's approved safe duration.
MAX_MOTOR_DURATION_MS=
MAX_SOUND_DURATION_MS=
