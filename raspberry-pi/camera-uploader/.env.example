# Required. Set the AI Server address reachable from this Raspberry Pi.
# The current uploader uses plain HTTP. Example: http://ai-server.internal:8000
AI_SERVER_BASE_URL=

# Must match the Backend camera-to-device mapping key.
CAMERA_ID=cam-001
CAPTURE_FPS=30
HTTP_TIMEOUT_SECONDS=10
UPLOAD_TRANSIENT_BACKOFF_SECONDS=1
STATS_INTERVAL_SECONDS=10
CAMERA_SOURCE=picamera2
# Used only when CAMERA_SOURCE=opencv. Prefer a stable /dev/v4l/by-id path.
CAMERA_DEVICE=/dev/video0
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Used only when CAMERA_SOURCE=file for a camera-free local smoke.
TEST_FRAME_PATH=
